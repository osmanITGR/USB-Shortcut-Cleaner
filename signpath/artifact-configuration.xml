<?xml version="1.0" encoding="utf-8"?>
<!-- Artifact configuration for the SignPath project (paste into SignPath > Project > Artifact Configurations).
     The GitHub artifact is a zip that contains the single exe; product name/version are enforced on it. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <zip-file>
    <pe-file path="USB_Shortcut_Cleaner.exe" product-name="USB Shortcut Cleaner" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
